rules_version = '2';

// Firebase Storage rules. Deploy with:
//     firebase deploy --only storage --project sanga-firebase-prod
// Anything not allowed below is DENIED.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    function isMainAdmin() {
      return isAdmin()
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'main';
    }

    // Cover library photos (admin site, "Cover library" page). Admins add and view them, only a main
    // admin removes one. The nextCoverPhoto Cloud Function reads them with the Admin SDK.
    match /coverLibrary/{category}/{file} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if isMainAdmin();
    }

    // Supporting files and pictures of an event (Create event page). Only the event's host adds or removes
    // them (the event must exist first, so the host can be checked); any signed-in person can read.
    // An admin may also remove one. Pictures are shown through their download links.
    match /eventFiles/{eventId}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && firestore.get(/databases/(default)/documents/events/$(eventId)).data.hostId == request.auth.uid
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.*|text/plain');
      allow update: if false;
      allow delete: if request.auth != null
                    && (firestore.get(/databases/(default)/documents/events/$(eventId)).data.hostId == request.auth.uid || isAdmin());
    }
  }
}

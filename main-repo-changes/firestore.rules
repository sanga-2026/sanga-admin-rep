rules_version = '2';

// Project-wide Firestore rules, shared by the Sanga app and the Sanga admin site (one database,
// one rules file). This file belongs in the MAIN sanga repo and is deployed from there:
//     firebase deploy --only firestore:rules
// Anything not allowed below is DENIED (there is no catch-all rule).
//
// Cloud Functions use the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isMainAdmin() {
      return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'main';
    }

    // A person's own profile. They can read it and change profile fields only. The PIN hash, the
    // lock-out counters and the device list live on the same record, so the browser is never
    // allowed to write them.
    //
    // NOTE: admins are deliberately NOT allowed to read this collection, because each record
    // contains the PIN hash. The admin site gets names and phone numbers from the adminListUsers
    // Cloud Function instead. Other people's profiles are served by the getPublicProfile Cloud
    // Function, which applies each person's privacy settings before returning anything.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
             .hasOnly(['name', 'phone', 'createdAt', 'bio', 'location', 'intentionLabel', 'intentionText',
                       'avatarDataUrl', 'practices', 'privacy', 'interests']);
      allow delete: if false;
    }

    // Requests for admin access. Created and decided ONLY by the Cloud Functions requestAdminAccess and
    // adminDecideRequest. A person can read their own request; main admins can read them all.
    match /adminRequests/{requestId} {
      allow read: if signedIn() && (request.auth.uid == requestId || isMainAdmin());
      allow write: if false;
    }

    // Admin records. Everyone with a record can read their own; only a MAIN admin can read all,
    // create, change or remove them (that is how people are promoted and their limits set).
    // The very first main admin is created by hand in the Firebase console (see README).
    match /admins/{adminId} {
      allow read: if signedIn() && (request.auth.uid == adminId || isMainAdmin());
      allow create, update, delete: if isMainAdmin();
    }

    // Published events (/events/create_event.html). Public read, same as today's prototype — anyone
    // can browse, including a signed-out visitor (event_detail_view.html explicitly supports that).
    // Only the host can create their own event, and only as themselves (hostId must be their own
    // uid) — one account can never publish as another. A host can change anything on their own
    // event; anyone signed in may touch ONLY the "booked" field, so a guest's booking can bump the
    // count without being able to edit the listing itself. There's no Cloud Function guarding the
    // exact increment amount — same trust level the rest of this prototype runs at (no payment
    // processing is server-verified either) — tighten this with a Cloud Function before this
    // becomes a real booking count anyone relies on.
    match /events/{eventId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.hostId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked'])
      );
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;
    }

    // One registration = one guest's completed booking form for one event (sanga_booking.html /
    // group_event_booking_invite.html). Booking is allowed without being signed in (a guest
    // checkout), so creation is open — the same trust level local-storage bookings had before this
    // migration (no server-verified payment either way). A registration can be read by whoever made
    // it (if they were signed in) or by the host of the event it's for; nothing can be edited or
    // deleted once made (cancellations are a later feature).
    match /registrations/{registrationId} {
      allow create: if request.resource.data.eventId is string && request.resource.data.eventId.size() > 0;
      allow read: if signedIn() && (
        (resource.data.standard is map && ('userId' in resource.data.standard)
          && resource.data.standard.userId == request.auth.uid) ||
        get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.hostId == request.auth.uid
      );
      allow update, delete: if false;
    }
  }
}

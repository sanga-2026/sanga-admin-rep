rules_version = '2';

// Project-wide Firestore rules, shared by the Sanga app and the Sanga admin site (one database,
// one rules file). This file belongs in the MAIN sanga repo and is deployed from there:
//     firebase deploy --only firestore:rules
// Anything not allowed below is DENIED (there is no catch-all rule).
//
// Cloud Functions use the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isMainAdmin() {
      return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'main';
    }

    // A person's own profile. They can read it and change profile fields only. The PIN hash, the
    // lock-out counters and the device list live on the same record, so the browser is never
    // allowed to write them.
    //
    // NOTE: admins are deliberately NOT allowed to read this collection, because each record
    // contains the PIN hash. The admin site gets names and phone numbers from the adminListUsers
    // Cloud Function instead. Other people's profiles are served by the getPublicProfile Cloud
    // Function, which applies each person's privacy settings before returning anything.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
             .hasOnly(['name', 'phone', 'createdAt', 'bio', 'location', 'intentionLabel', 'intentionText',
                       'avatarDataUrl', 'practices', 'privacy', 'interests']);
      allow delete: if false;
    }

    // Requests for admin access. Created and decided ONLY by the Cloud Functions requestAdminAccess and
    // adminDecideRequest. A person can read their own request; main admins can read them all.
    match /adminRequests/{requestId} {
      allow read: if signedIn() && (request.auth.uid == requestId || isMainAdmin());
      allow write: if false;
    }

    // Admin records. Everyone with a record can read their own; only a MAIN admin can read all,
    // create, change or remove them (that is how people are promoted and their limits set).
    // The very first main admin is created by hand in the Firebase console (see README).
    match /admins/{adminId} {
      allow read: if signedIn() && (request.auth.uid == adminId || isMainAdmin());
      allow create, update, delete: if isMainAdmin();
    }

    // ------------------------------------------------------------------------------------------
    // Events, bookings, consent forms and host settings (see docs/database_shape.md).
    // ------------------------------------------------------------------------------------------
    function uid() { return request.auth.uid; }
    function eventHost(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.hostId;
    }

    // An event. Published and finished events can be read by anyone (guests are not always logged
    // in); a host can also read their own in any status; an admin can read any event, in any
    // status, to run the review queue. A new event starts 'pending_review' (see
    // SanghaData.createEvent) and is invisible to the public until an admin approves it.
    // The host creates, edits or deletes their own event (and can't touch the booked count — only
    // the booking Cloud Function does). Separately, an admin may change ONLY the status field, and
    // only to 'published', 'rejected', 'flagged' or back to 'pending_review' — the Sanga admin
    // site's review queue (and a reviewer's Approve/Flag buttons on the event details page), not
    // the host side. 'flagged' is not a final decision: it just marks an event for another admin
    // to make the final approve/reject call; it is treated the same as 'pending_review' everywhere
    // outside the review queue (not public, not final).
    match /events/{eventId} {
      allow read: if resource.data.status in ['published', 'completed']
                  || (signedIn() && (resource.data.hostId == uid() || isAdmin()));
      allow create: if signedIn() && request.resource.data.hostId == uid()
                    && request.resource.data.booked == 0;
      allow update: if signedIn() && (
        (resource.data.hostId == uid()
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.booked == resource.data.booked)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'reviewedBy', 'reviewedAt'])
          && request.resource.data.status in ['published', 'rejected', 'flagged', 'pending_review'])
      );
      allow delete: if signedIn() && resource.data.hostId == uid();
    }

    // A booking. The guest reads their own; the host reads all bookings of their own events.
    // Written ONLY by the booking Cloud Function (it checks the spots left), never by a browser.
    match /registrations/{registrationId} {
      allow read: if signedIn() && (resource.data.userId == uid() || resource.data.hostId == uid());
      allow write: if false;
    }

    // The consent form of an event. Any logged-in person can read it (to sign); only that event's host
    // writes it. Signed answers: a guest adds their own, only the host reads them. No edits or deletes.
    match /consentForms/{eventId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.hostId == uid()
                            && eventHost(eventId) == uid();
      allow delete: if false;

      match /submissions/{submissionId} {
        allow create: if signedIn() && request.resource.data.userId == uid();
        allow read: if signedIn() && eventHost(eventId) == uid();
        allow update, delete: if false;
      }
    }

    // A host's saved defaults (cancellation policy, payment method, usual questions). Own record only.
    match /hostSettings/{hostId} {
      allow read, write: if signedIn() && uid() == hostId;
    }

    // A host's unfinished ("Incomplete") events. Private to them.
    match /users/{userId}/drafts/{draftId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // The events a person saved with the heart. Private to them.
    match /users/{userId}/savedEvents/{eventId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // The cover library: photos handed out by the "Suggest one" button on Create event.
    // Admins add and read them (admin site, "Cover library" page); only a MAIN admin removes one.
    // Hosts never read this directly: the nextCoverPhoto Cloud Function picks the next photo for them.
    match /coverLibrary/{category} {
      allow read, create, update: if isAdmin();
      allow delete: if isMainAdmin();

      match /photos/{photoId} {
        allow read, create, update: if isAdmin();
        allow delete: if isMainAdmin();
      }
    }
  }
}
